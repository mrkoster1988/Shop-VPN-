# Объедините с существующим блоком глобальных настроек, если он уже есть.
{
    log default {
        format filter {
            wrap json
            fields {
                request>uri replace REDACTED
            }
        }
    }
}
# Добавьте эти маршруты в существующий блок сайта; замените example.com своим доменом.
# Сохраните существующие маршруты основного сайта.
# PUBLIC_URL=https://example.com/shop
example.com {
    @private_shop path /shop/login /shop/sub/*
    log_skip @private_shop
    encode gzip
    @shop_root path /shop
    redir @shop_root /shop/ 308
    @shop path /shop/*
    handle @shop {
        reverse_proxy 127.0.0.1:8000
    }
    # Сохраните здесь существующие handle / reverse_proxy / file_server основного сайта.
}
# Caddy работает на хосте. Для Docker настройте подходящую частную сеть или сеть хоста.
# Не включайте журнал запросов: /shop/login содержит одноразовый секрет входа.
# Используйте handle, а не handle_path: приложение ожидает сохранённый префикс /shop.
