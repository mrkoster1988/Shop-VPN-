# Только локальная разработка. Перед развёртыванием укажите свой HTTPS-адрес.
PUBLIC_URL=http://localhost:8000/shop
ADMIN_TOKEN=
ENCRYPTION_KEY=
BOT_TOKEN=
BOT_USERNAME=
# Отдельный купон и HMAC-секрет для проверенных событий внешнего бота.
PARTNER_PROMO_CODE=
PARTNER_WEBHOOK_SECRET=
SUPPORT_TEXT="Поддержка: @your_support"
TERMS_TEXT=
# PAYMENT_MODE: manual, yookassa (страница ЮKassa) или sbp (отдельная оплата через СБП).
# Значение для email-аккаунтов сайта; аккаунты Telegram продолжают использовать Stars.
# Для sbp нужны активный СБП в ЮKassa и действующие реквизиты.
PAYMENT_MODE=manual
MANUAL_PAYMENT_TEXT="Свяжитесь с @your_support. Укажите номер заказа; администратор сообщит реквизиты."
YOOKASSA_SHOP_ID=
# Для СБП и обычных платежей ЮKassa используются одни и те же учётные данные.
YOOKASSA_SECRET=
# URL webhook: https://ваш-домен/shop/api/payments/yookassa/notify
# События payment.succeeded и payment.canceled настраиваются в кабинете ЮKassa.
# Включайте чеки после настройки кода НДС для своего магазина.
YOOKASSA_RECEIPTS=false
YOOKASSA_VAT_CODE=1
# Импортируются ОДИН РАЗ при первом запуске в зашифрованный реестр серверов.
# Затем меняйте профили в /shop/admin; правка .env не переносит подписки.
# При обновлении базы с действующими подписками сохраняйте исходные значения.
# API режима Legacy; укажите секретный подпуть панели без завершающего слеша.
XUI_URL=
XUI_USERNAME=
XUI_PASSWORD=
XUI_INBOUND_ID=
XUI_FLOW=
# Скопируйте рабочую VLESS-ссылку из inbound и замените ТОЛЬКО UUID клиента на {uuid}.
XUI_LINK_TEMPLATE=
# Для удалённого агента используйте HTTPS либо частную сеть Docker. Публичный HTTP недопустим.
WG_AGENT_URL=
WG_AGENT_TOKEN=

# Обслуживание блокирует покупки и приватные маршруты, отключает запуск бота и обработчика.
MAINTENANCE_MODE=false

# Опциональные иконки кнопок Telegram. По умолчанию выключены до публикации Pushok Custom Emoji.
PUSHOK_BUTTON_ICONS_ENABLED=0
# JSON с реальными числовыми custom_emoji_id, без токенов и плейсхолдеров.
PUSHOK_BUTTON_EMOJI_JSON=

# Служба обновления опциональна. setup_host_updater.py добавляет
# PUSHOK_HOST_UPDATER_PORT и PUSHOK_HOST_UPDATER_TOKEN автоматически.
# Токен службы не вводится в браузере и не публикуется.
