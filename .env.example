PUBLIC_URL=https://pushok.shop/shop
ADMIN_TOKEN=
ENCRYPTION_KEY=
BOT_TOKEN=
BOT_USERNAME=
SUPPORT_TEXT="Поддержка: @your_support"
TERMS_TEXT=
# PAYMENT_MODE is for website email accounts. Telegram accounts use Stars.
PAYMENT_MODE=manual
MANUAL_PAYMENT_TEXT="Свяжитесь с @your_support. Укажите номер заказа; администратор сообщит реквизиты."
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=
# Enable receipts only after setting VAT code appropriate for your merchant account.
YOOKASSA_RECEIPTS=false
YOOKASSA_VAT_CODE=1
# Imported ONCE at first startup into the encrypted server registry.
# Afterwards edit profiles in /shop/admin; .env changes do not move subscriptions.
# Keep original values for upgrades of databases with existing subscriptions.
# Legacy 3x-ui 2.x API; include the panel secret base path, without trailing slash.
XUI_URL=
XUI_USERNAME=
XUI_PASSWORD=
XUI_INBOUND_ID=
XUI_FLOW=
# Copy a working VLESS link from your inbound and replace ONLY client UUID with {uuid}.
XUI_LINK_TEMPLATE=
# HTTPS for a remote agent, or private Docker-network URL. Never public plain HTTP.
WG_AGENT_URL=
WG_AGENT_TOKEN=
