[Unit]
Description=Pushok WireGuard private control agent
After=network-online.target wg-quick@wg-pushok.service
Requires=wg-quick@wg-pushok.service

[Service]
Type=simple
WorkingDirectory=/opt/pushok-vpn
EnvironmentFile=/opt/pushok-vpn/agent/.env
ExecStart=/opt/pushok-vpn/.venv/bin/python -m uvicorn agent.main:app --host 127.0.0.1 --port 8787 --workers 1 --no-access-log
Restart=always
RestartSec=5
User=root
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pushok-wg
PrivateTmp=true
ProtectHome=true
CapabilityBoundingSet=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
